JSEARCH_RAPIDAPI_KEY=
SERPAPI_KEY=
OPENWEB_NINJA_API_KEY=

# Claude (used to score each new job against your role and experience)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5

# Search defaults (ISO country code for JSearch / SerpApi)
COUNTRY=in

# OpenWeb Ninja Real-Time Jobs Data (Google Jobs). Free plan = 100 requests/month.
OPENWEB_NINJA_URL=https://api.openwebninja.com/realtime-jobs-data/google-jobs/search
OPENWEB_NINJA_AUTH_HEADER=X-API-Key
OPENWEB_NINJA_PAGES=1
